<config>
    <executableName>${app.executable}</executableName>
    <mainClass>${app.mainclass}</mainClass>
    <os>ios</os><arch>arm64</arch>
    <target>ios</target>
    <iosInfoPList>Info.plist.xml</iosInfoPList>
    <resources><resource><directory>launch</directory></resource>
        <resource><directory>bootstrap</directory></resource>
        <resource><directory>icons</directory><includes><include>*.png</include></includes></resource>
        <resource><directory>../build/gameAssets</directory></resource>
    </resources>
    <forceLinkClasses><pattern>com.badlogic.gdx.backends.iosrobovm.**</pattern><pattern>com.badlogic.gdx.graphics.g3d.particles.**</pattern></forceLinkClasses>
    <libs><lib>z</lib></libs>
    <frameworks><framework>UIKit</framework><framework>OpenGLES</framework><framework>QuartzCore</framework><framework>CoreGraphics</framework><framework>OpenAL</framework><framework>AudioToolbox</framework><framework>AVFoundation</framework></frameworks>
</config>
